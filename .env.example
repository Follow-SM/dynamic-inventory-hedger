# FollowSM: ENTERPRISE for SIGNAL_SOURCE=stream (WebSocket); any tier works with SIGNAL_SOURCE=poll.
# Get a key: https://follow-sm.com/pricing
FOLLOWSM_API_KEY=
SIGNAL_SOURCE=stream

# Polymarket proxy wallet holding the positions to hedge (public data, no key needed).
# Leave empty to run examples/polymarket_binance_hedge.py with a sample position.
POLYMARKET_WALLET=
# Optional JSON: {"<market-slug>": {"underlying": "BTCUSDT", "beta_pp_per_pct": 0.8}}
MANUAL_MARKETS_FILE=

# Toxicity bands on vpin_percentile (VPIN ranked against the symbol's own recent history).
PRE_HEDGE_PERCENTILE=0.85
EMERGENCY_PERCENTILE=0.95
REBALANCE_PERCENTILE=0.60
# Raw-VPIN fallback, used only while vpin_percentile is warming up.
PRE_HEDGE_RAW_VPIN=0.80
EMERGENCY_RAW_VPIN=0.90
REBALANCE_RAW_VPIN=0.60

# Hedge policy
PRE_HEDGE_RATIO=0.5
EMERGENCY_HEDGE_RATIO=1.0
MAX_INVENTORY_USD=25000
PASSIVE_SLICE_USD=2000

# Execution: paper by default. LIVE_TRADING=true + BINANCE_DEMO=true -> Binance futures demo.
LIVE_TRADING=false
BINANCE_DEMO=true
# Futures-enabled key with withdrawals DISABLED and an IP allow-list. NEVER commit real keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
MAX_SLIPPAGE_BPS=15
MAX_SPREAD_BPS=25

JOURNAL_PATH=hedger_journal.jsonl
